pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'garlgaru/ch-ai', description: 'AI Docker image name')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'AI Docker image tag')
        credentials(name: 'DOCKER_REGISTRY_CREDENTIALS', defaultValue: 'docker-registry', description: 'Docker registry username/password', credentialType: 'com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl')
        credentials(name: 'EC2_SSH_KEY', defaultValue: 'ec2-ssh-key', description: 'EC2 SSH private key', credentialType: 'com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey')
    }

    environment {
        FULL_IMAGE = "${params.IMAGE_NAME}:${params.IMAGE_TAG}"
    }

    stages {
        stage('Build Image') {
            steps {
                sh 'docker build -f deploy/Dockerfile -t "$FULL_IMAGE" .'
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${params.DOCKER_REGISTRY_CREDENTIALS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$FULL_IMAGE"
                    '''
                }
            }
        }

        stage('Deploy To EC2') {
            steps {
                sh '''
                    test -n "$AI_EC2_HOST"
                    test -n "$AI_EC2_USER"
                    test -n "$AI_EC2_DEPLOY_DIR"
                '''
                sshagent(credentials: ["${params.EC2_SSH_KEY}"]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no "$AI_EC2_USER@$AI_EC2_HOST" "mkdir -p '$AI_EC2_DEPLOY_DIR/deploy'"
                        scp -o StrictHostKeyChecking=no deploy/docker-compose.yml "$AI_EC2_USER@$AI_EC2_HOST:$AI_EC2_DEPLOY_DIR/deploy/docker-compose.yml"
                        ssh -o StrictHostKeyChecking=no "$AI_EC2_USER@$AI_EC2_HOST" "
                            cd '$AI_EC2_DEPLOY_DIR' &&
                            AI_IMAGE='$FULL_IMAGE' docker compose --env-file .env -f deploy/docker-compose.yml pull ch-ai &&
                            AI_IMAGE='$FULL_IMAGE' docker compose --env-file .env -f deploy/docker-compose.yml up -d --no-build ch-ai &&
                            docker image prune -f
                        "
                    '''
                }
            }
        }
    }
}
